# Industrial Mind OS Environment Variables
# Copy this file to .env and insert your actual keys

# Required — powers all LLM calls (synthesis, planning, OCR, auditor agent)
GOOGLE_API_KEY=your-gemini-api-key-here

# Required — signs local auth JWTs (SQLite-backed users). The backend refuses to
# start without it, so tokens can never be signed with a publicly known key.
# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# Optional — web search providers for Online/Hybrid mode (falls back to DuckDuckGo if unset)
# TAVILY_API_KEY=tvly-your-tavily-key
# FIRE_CRAWL_API_KEY=fc-your-firecrawl-key

# Optional — comma-separated browser origins allowed to call the API.
# Defaults to the local Vite dev servers. Set this when deploying the frontend.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Optional — reject uploads larger than this (default 25). Uploads are read fully
# into memory before text extraction.
# MAX_UPLOAD_MB=25

# Optional — point at a real Qdrant server instead of local disk mode. Local mode
# holds an exclusive lock on backend/qdrant_data/, so it allows one backend
# process only; set this to run multiple uvicorn workers.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-key
