# Industrial Mind OS Environment Variables
# Copy this file to .env and insert your actual keys

# Required — powers all LLM calls (synthesis, planning, OCR, auditor agent)
GOOGLE_API_KEY=your-gemini-api-key-here

# Required — signs local auth JWTs (SQLite-backed users). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# Optional — web search providers for Online/Hybrid mode (falls back to DuckDuckGo if unset)
# TAVILY_API_KEY=tvly-your-tavily-key
# FIRE_CRAWL_API_KEY=fc-your-firecrawl-key
